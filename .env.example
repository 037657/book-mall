# ============ 服务端配置（server/） ============
# 服务端口（默认 3000）
PORT=3000

# JWT 密钥（生产环境务必改成随机字符串，例如 openssl rand -hex 32 生成）
JWT_SECRET=please-change-me-to-a-random-string

# JWT 有效期
JWT_EXPIRES=7d

# SQLite 数据库文件路径（不设置则默认 server/data/library.db）
# 注意：请使用绝对路径；Render 上建议填写 /var/data/library.db
# DB_PATH=/var/data/library.db

# 允许的前端来源（多个用逗号分隔，* 表示全部放开）
CLIENT_ORIGIN=*
